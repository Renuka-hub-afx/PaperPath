<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PaperPath">

        <!-- Sign In Screen (Main Launcher) -->
        <activity
            android:name=".SignInActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sign Up Screen -->
        <activity
            android:name=".SignUpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Research Domain / Topic Selection Screen -->
        <activity
            android:name=".TopicSelectionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Home Screen (Conference Name Feed) -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Settings & Profile Screen -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- Conference Detail Card Screen -->
        <activity
            android:name=".ConferenceDetailActivity"
            android:exported="false" />

    </application>

</manifest>