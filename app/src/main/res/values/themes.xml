<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme using MaterialComponents to support all Material widgets in Layout Editor -->
    <style name="Base.Theme.PaperPath" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Brand colors: Dark Blue and White -->
        <item name="colorPrimary">@color/dark_blue_primary</item>
        <item name="colorPrimaryVariant">@color/dark_blue_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorSecondaryVariant">@color/dark_blue_light</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.PaperPath" parent="Base.Theme.PaperPath" />

    <!-- Dark Blue Primary Button Style -->
    <style name="Widget.PaperPath.Button.DarkBlue" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/dark_blue_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- White Outlined Button Style with Dark Blue Accent -->
    <style name="Widget.PaperPath.Button.WhiteOutlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/dark_blue_primary</item>
        <item name="strokeColor">@color/dark_blue_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>